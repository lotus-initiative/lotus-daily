# Mastodon credentials
MASTODON_API_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=your_mastodon_access_token

# Optional LinkedIn cross-posting credentials
# Use urn:li:person:<ID> for a personal account OR urn:li:organization:<ID> for a LOTUS Initiative LinkedIn Page
# Organization posting requires the Share on LinkedIn / Community Management API product with w_organization_social scope
# Note: standard LinkedIn OAuth access tokens expire after 60 days
# LINKEDIN_ACCESS_TOKEN=your_oauth_access_token
# LINKEDIN_AUTHOR_URN=urn:li:organization:12345678
# LINKEDIN_API_VERSION=202601
