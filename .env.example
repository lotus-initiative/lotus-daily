# Required Mastodon credentials
MASTODON_API_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=your_mastodon_access_token

# Optional SPARQL configuration (QLever is queried first, falling back to WDQS)
# SPARQL_ENDPOINT=https://qlever.dev/api/wikidata
# SPARQL_TIMEOUT=45

# Optional rotating log configuration
# LOTUS_LOG_DIR=logs
# LOTUS_LOG_LEVEL=INFO
# LOTUS_LOG_MAX_BYTES=5242880
# LOTUS_LOG_BACKUP_COUNT=5
